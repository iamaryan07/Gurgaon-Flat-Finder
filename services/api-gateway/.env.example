# Downstream service URLs proxied by the gateway.
# In Docker Compose, PREDICTION_SERVICE_URL is overridden to the local
# prediction load balancer (http://prediction-load-balancer:8001).
PREDICTION_SERVICE_URL=http://localhost:8001
MARKET_SERVICE_URL=http://localhost:8002
RECOMMENDATION_SERVICE_URL=http://localhost:8003

WEB_ORIGIN=http://localhost:3000
