# Free PostgreSQL from Neon or Supabase. Leave blank for API-only local development.
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
# Model is downloaded from Hugging Face Hub (public repo, no token required).
MODEL_REPO_ID=iamAryan/gurgaon-property-price-model
MODEL_FILENAME=property_price_model.pkl
WEB_ORIGIN=http://localhost:3000
