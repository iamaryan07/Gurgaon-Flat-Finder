# Copy this file to `.env` and fill in real values before running
# `docker compose up`. docker-compose.yml reads these variables and injects
# them into the relevant containers. Nothing here is committed with secrets.
#
# Note: the RabbitMQ and database connection strings are loaded from each
# service's own .env file via env_file (not from this root .env):
#   - prediction-service    -> services/prediction-service/.env (RABBITMQ_URL)
#   - prediction-consumer   -> services/prediction-consumer/.env (RABBITMQ_URL, DATABASE_URL)
#
# This root .env is only used for the Redis caching connection string read by
# market-service and recommendation-service. Leave REDIS_URL empty to disable caching.
REDIS_URL=

# Optional overrides (defaults are shown and already set in docker-compose.yml).
# MODEL_REPO_ID=iamAryan/gurgaon-property-price-model
# MODEL_FILENAME=property_price_model.pkl
# REDIS_CACHE_TTL_SECONDS=600
