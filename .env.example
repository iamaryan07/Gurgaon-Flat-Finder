# Copy this file to `.env` only if you want to override non-secret defaults.
# docker-compose.yml reads these variables and injects them into the relevant
# containers. Nothing here is committed with secrets.
#
# Connection strings are loaded from each service's own .env file via env_file
# (NOT from this root .env):
#   - prediction-service      -> services/prediction-service/.env      (RABBITMQ_URL)
#   - prediction-consumer     -> services/prediction-consumer/.env     (RABBITMQ_URL, DATABASE_URL)
#   - market-service          -> services/market-service/.env          (REDIS_URL)
#   - recommendation-service  -> services/recommendation-service/.env  (REDIS_URL)

# Optional overrides (defaults are shown and already set in docker-compose.yml).
# MODEL_REPO_ID=iamAryan/gurgaon-property-price-model
# MODEL_FILENAME=property_price_model.pkl
# REDIS_CACHE_TTL_SECONDS=600
